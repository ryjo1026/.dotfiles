{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "appearance": "dark",
    "forkConversationDefaultDestination": "newTab"
  },
{{- if eq .profile "work" }}
  "terminal": {
    "agentHibernation": {
      "enabled": true
    }
  },
{{- end }}
  "actions": {
    "lazygit": {
      "type": "command",
      "title": "Lazygit",
      // cmux has no headless action target, so this runs in a transient focused tab; every path must exec so the tab closes immediately.
      // The toggle matches the rename-tab title, lowercase "lazygit"; this action's own tab ("Lazygit") must stay capitalized to never self-match.
      "command": "s=$(cmux list-panels --json | jq -r '[.surfaces[] | select(.title==\"lazygit\") | .ref] | first // empty'); [ -n \"$s\" ] && exec cmux focus-panel --panel \"$s\"; r=$(cmux new-split right --focus true --json | jq -r .surface_ref); cmux rename-tab --surface \"$r\" lazygit; exec cmux send --surface \"$r\" 'exec lazygit\\r'",
      "target": "newTabInCurrentPane",
      "shortcut": ["ctrl+b", "g"]
    }
  },
  "shortcuts": {
    "bindings": {
      "newSurface": ["ctrl+b", "c"],
      "nextSurface": ["ctrl+b", "n"],
      "prevSurface": ["ctrl+b", "p"],
      "renameTab": ["ctrl+b", ","],
      "closeTab": ["ctrl+b", "x"],
      "toggleSidebar": ["ctrl+b", "w"],
      "selectSurfaceByNumber": ["ctrl+b", "1"],

      "splitRight": ["ctrl+b", "shift+5"],
      "splitDown": ["ctrl+b", "shift+'"],
      "focusLeft": ["ctrl+b", "h"],
      "focusRight": ["ctrl+b", "l"],
      "focusUp": ["ctrl+b", "j"],
      "focusDown": ["ctrl+b", "k"],
      "toggleSplitZoom": ["ctrl+b", "z"],

      "renameWorkspace": ["ctrl+b", "shift+4"],
      "goToWorkspace": ["ctrl+b", "s"],
      "prevSidebarTab": ["ctrl+b", "shift+9"],
      "nextSidebarTab": ["ctrl+b", "shift+0"],
      "closeWorkspace": ["ctrl+b", "d"],

      "commandPalette": "cmd+shift+p",
      "toggleTerminalCopyMode": ["ctrl+b", "["],
      "find": ["ctrl+b", "f"],
      "showNotifications": ["ctrl+b", "i"]
    }
  }
}
