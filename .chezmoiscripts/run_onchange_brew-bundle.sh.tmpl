{{- if ne .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
exit 0
{{- else -}}
#!/usr/bin/env bash
# Brewfile hash: {{ include "dot_Brewfile.tmpl" | sha256sum }}
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew not installed; skipping brew bundle"
  exit 0
fi

BREWFILE="$HOME/.Brewfile"
if [[ ! -f "$BREWFILE" ]]; then
  echo "No Brewfile at $BREWFILE; skipping"
  exit 0
fi

echo "Running brew bundle using $BREWFILE (profile={{ .profile | default "home" }})"
brew bundle --file "$BREWFILE"
{{- end }}
