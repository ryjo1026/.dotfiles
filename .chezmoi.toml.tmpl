{{- $profile := promptStringOnce . "profile" "Machine profile (work/personal)" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $sshKeyTitle := promptStringOnce . "sshKeyTitle" "SSH key title" -}}
{{- $aerospaceEnabled := promptBoolOnce . "aerospaceEnabled" "Enable AeroSpace window manager" -}}
{{- $sketchybarEnabled := promptBoolOnce . "sketchybarEnabled" "Enable SketchyBar status bar" -}}
{{- $gitSigningKey := promptStringOnce . "gitSigningKey" "Git signing key path" -}}

[data]
    profile = {{ $profile | quote }}
    email = {{ $email | quote }}
    sshKeyTitle = {{ $sshKeyTitle | quote }}
    aerospaceEnabled = {{ $aerospaceEnabled }}
    sketchybarEnabled = {{ $sketchybarEnabled }}
    gitSigningKey = {{ $gitSigningKey | quote }}
