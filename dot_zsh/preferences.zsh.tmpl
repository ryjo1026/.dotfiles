# ----------------------------------------
# PREFERENCES
# ----------------------------------------

# Variables
export EDITOR='vim'
export SSH_KEY_PATH="~/.ssh/rsa_id"

{{- if eq .chezmoi.os "darwin" }}
# Load in OpenSSL vars
  {{- if eq .chezmoi.arch "arm64" }}
export CPPFLAGS=-I/opt/homebrew/opt/openssl/include
export LDFLAGS=-L/opt/homebrew/opt/openssl/lib
  {{- else }}
export CPPFLAGS=-I/usr/local/opt/openssl/include
export LDFLAGS=-L/usr/local/opt/openssl/lib
  {{- end }}
{{- end }}

# ZSH options
setopt auto_cd                      # cd by typing directory name if it's not a command
setopt complete_in_word             # tab-complete from cursor position, not end of word
# make cd behave like pushd (have a stack)
setopt autopushd pushdminus pushdsilent pushdtohome cdablevars
DIRSTACKSIZE=5

export ZSH_AUTOSUGGEST_USE_ASYNC=1  # speed up autosuggestions

export GIT_AUTO_FETCH_INTERVAL=300  # throttle git-auto-fetch to once per 5 min
