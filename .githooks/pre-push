#!/usr/bin/env bash
set -euo pipefail

# Test chezmoi templates render without errors across target machines
# Runs automatically before `git push` when core.hooksPath is set to .githooks

TEMPLATES=$(find . -name '*.tmpl' -not -path './.git/*')
# execute-template resolves `include` and `glob` against the configured source
# dir, not the cwd, so a worktree would otherwise validate against the main
# checkout's files.
SOURCE_DIR=$(git rev-parse --show-toplevel)
FAILURES=0
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

# Target environments:
#   - Personal Mac (darwin/arm64)
#   - Work Mac (darwin/arm64)
#   - Unraid server (linux/amd64)
declare -a COMBOS=(
  "darwin/arm64"
  "linux/amd64"
)

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " chezmoi template validation"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

for combo in "${COMBOS[@]}"; do
  os="${combo%%/*}"
  arch="${combo##*/}"

  config="$TMPDIR/chezmoi-${os}-${arch}.toml"
  cat > "$config" <<TOML
[data]
$(cat .chezmoidata/defaults.toml)

[data.chezmoi]
  os = "${os}"
  arch = "${arch}"
TOML

  target_failures=0
  for tmpl in $TEMPLATES; do
    # --init supplies promptStringOnce for the config template, but hides
    # .chezmoidata from every other template, which apply does not.
    init_flag=""
    if [ "$tmpl" = "./.chezmoi.toml.tmpl" ]; then
      init_flag="--init"
    fi

    output=$(chezmoi execute-template \
      $init_flag \
      --config="$config" \
      --source="$SOURCE_DIR" \
      < "$tmpl" 2>&1) || {
        echo "  FAIL: $tmpl"
        echo "    $output"
        FAILURES=$((FAILURES + 1))
        target_failures=$((target_failures + 1))
      }
  done

  if [ "$target_failures" -eq 0 ]; then
    echo "  ✓ ${os}/${arch}"
  else
    echo "  ✗ ${os}/${arch} (${target_failures} failed)"
  fi
done

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ "$FAILURES" -gt 0 ]; then
  echo "  Template rendering failed. Push aborted."
  exit 1
fi

echo "  All templates valid. Pushing."
