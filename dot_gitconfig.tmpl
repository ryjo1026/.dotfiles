[core]
	editor = vim
	pager = less -FMRiX
	program = gpg
	excludesfile = ~/.gitignore
[init]
	defaultBranch = main
[commit]
	template = ~/.gitmessage
	gpgsign = true
[tag]
	forceSignAnnotated = true
	gpgSign = true
[rebase]
	gpgSign = true
	autoStash = true
	autoSquash = true
[push]
	default = simple
[pull]
	rebase = true
	ff = only
[fetch]
	prune = true
[rerere]
	enabled = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
[color]
	ui = auto
[alias]
	dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)%an <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
[gpg]
	format = ssh
[user]
	signingkey = {{ .gitSigningKey }}
	email = {{ .email }}
	name = Ryan Johnston
