[core]
	editor = vim
	pager = less -FMRiX
	program = gpg
	excludesfile = ~/.gitignore
[commit]
	template = ~/.gitmessage
	gpgsign = true
[tag]
	forceSignAnnotated = true
	gpgSign = true
[rebase]
	gpgSign = true
[push]
	default = simple
[pull]
	rebase = true
	ff = only
[color]
	ui = auto
[alias]
	dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)%an <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
[gpg]
	format = ssh
[user]
	signingkey = {{ .gitSigningKey }}
	email = {{ .email }}
	name = Ryan Johnston
